# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# Where training/promotion/monitoring scripts talk to MLflow (host machine)
MLFLOW_TRACKING_URI=http://localhost:5000

# Model the API serves (registry alias URI). Can also be a local path for testing.
MODEL_URI=models:/fraud-detector@champion

# Probability above which a transaction is flagged as fraud.
# Use the F1-optimal threshold printed by `python -m src.train` (also in reports/metrics.json).
FRAUD_THRESHOLD=0.5

# Directory where the API appends request/prediction logs (JSONL)
PREDICTION_LOG_DIR=data/logs

# Used by scripts/simulate_drift.py
API_URL=http://localhost:8000

# Grafana admin login (docker-compose reads these)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports for docker compose. Change them if something else on your machine already uses one
# (e.g. another app on 8000 or a locally installed Grafana on 3000). Keep API_URL in sync.
API_PORT=8000
GRAFANA_PORT=3000
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
